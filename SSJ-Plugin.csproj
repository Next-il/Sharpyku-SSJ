<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.364">
      <PrivateAssets>none</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Loaded at runtime from shared/CS2MenuManager - the same 1.0.42 build every server ships -->
    <PackageReference Include="CS2MenuManager" Version="1.0.42">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <Reference Include="SharpTimerAPI">
      <!-- Reference only: the copy from Mounts shared/SharpTimerAPI, loaded at runtime from there -->
      <HintPath>lib\SharpTimerAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
